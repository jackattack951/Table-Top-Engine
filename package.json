{
    "name": "ttrpg-stage-manager",
    "version": "0.1.0",
    "description": "DM cockpit and theatrical atmosphere engine for in-person TTRPG sessions",
    "main": "out/main/index.js",
    "author": "TTRPG Stage Manager",
    "private": true,
    "scripts": {
        "dev": "npm run build:cockpit && npm run build:companion && concurrently \"npm run dev:electron\" \"npm run dev:cockpit\" \"npm run dev:companion\"",
        "dev:electron": "electron-vite dev",
        "dev:cockpit": "vite --config vite.cockpit.config.ts",
        "dev:companion": "vite --config vite.companion.config.ts",
        "build": "electron-vite build",
        "build:cockpit": "vite build --config vite.cockpit.config.ts",
        "build:companion": "vite build --config vite.companion.config.ts",
        "build:all": "electron-vite build && npm run build:cockpit && npm run build:companion",
        "pack": "npm run build:all && electron-builder --dir",
        "dist": "npm run build:all && electron-builder",
        "dist:win": "npm run build:all && electron-builder --win",
        "preview": "electron-vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "lint": "eslint . --ext .ts,.tsx",
        "postinstall": "electron-builder install-app-deps"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.1",
        "@codemirror/commands": "^6.10.2",
        "@codemirror/lang-markdown": "^6.5.0",
        "@codemirror/state": "^6.5.4",
        "@codemirror/theme-one-dark": "^6.1.3",
        "@codemirror/view": "^6.39.16",
        "@phosphor-icons/react": "^2.1.10",
        "better-sqlite3": "^9.4.3",
        "express": "^4.18.2",
        "pdfjs-dist": "^4.9.155",
        "pixi.js": "^8.16.0",
        "qrcode": "^1.5.4",
        "socket.io": "^4.7.4",
        "socket.io-client": "^4.7.4",
        "tone": "^14.9.17",
        "zustand": "^4.5.2"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-prettier": "^2.0.0",
        "@electron-toolkit/eslint-config-ts": "^2.0.0",
        "@electron-toolkit/tsconfig": "^1.0.1",
        "@types/better-sqlite3": "^7.6.8",
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.20",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^18.2.57",
        "@types/react-dom": "^18.2.19",
        "@vitejs/plugin-react": "^4.2.1",
        "concurrently": "^8.2.2",
        "electron": "^29.4.6",
        "electron-builder": "^26.8.1",
        "electron-vite": "^2.0.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "typescript": "^5.3.3",
        "vite": "^5.1.4",
        "vitest": "^1.3.1"
    }
}
